# Database connection (PostgreSQL / Supabase pooler connection string)
DATABASE_URL=postgresql://user:password@host:6543/postgres

# HTTP Basic Auth credentials
APP_USERNAME=your_username_here
APP_PASSWORD=your_password_here

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# Supabase Storage (profile photo uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Demo mode (public portfolio deployment only)
# true = example books are read-only, visitor books are cleaned up, profile is locked
DEMO_MODE=false
# How many visitor books the demo keeps at once (oldest are removed first)
DEMO_MAX_VISITOR_BOOKS=30
# How many days a visitor book stays in the demo
DEMO_VISITOR_BOOK_DAYS=1

# Optional: Google Books API key used by seed_demo.py to fetch covers
GOOGLE_BOOKS_KEY=
