# Database connection (PostgreSQL / Supabase pooler connection string)
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Login tokens (JWT): a long random secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me
# How many days a login lasts
JWT_EXPIRE_DAYS=7

# true = anyone can create an account (public deployment); false = only accounts created with manage.py
ALLOW_SIGNUP=false
# Max books per account
MAX_BOOKS_PER_USER=2000

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# Supabase Storage (profile photo uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Demo mode: enables the shared visitor account (/auth/visitor)
# true = visitor example books are read-only, visitor books are cleaned up, visitor settings are locked
DEMO_MODE=false
# How many books the visitor account keeps at once (oldest are removed first)
DEMO_MAX_VISITOR_BOOKS=30
# How many days a book added by the visitor stays
DEMO_VISITOR_BOOK_DAYS=1

# Optional: Google Books API key used by seed_demo.py to fetch covers
GOOGLE_BOOKS_KEY=
